# Copy to .env.deploy and fill in. NEVER commit .env.deploy.
# Then: node scripts/deploy.mjs

# ─── Coolify ─────────────────────────────────────────────
# Your Coolify instance URL (no trailing slash)
COOLIFY_URL=https://coolify.elevo.solutions
# API token: Coolify → Settings → Keys & Tokens → Create Token
COOLIFY_TOKEN=
# Optional: pin to a specific server. Leave empty if you only have one.
# COOLIFY_SERVER_UUID=

# ─── Cloudflare ──────────────────────────────────────────
# API token (My Profile → API Tokens → Create Token).
# Required scopes: Zone:DNS:Edit, Zone:Cache Purge, Zone:Read — only for elevo.solutions
CF_TOKEN=
# Root domain (zone)
CF_DOMAIN=elevo.solutions
# Whether to proxy traffic through Cloudflare (orange cloud). Recommended: true.
CF_PROXIED=true

# ─── Site ────────────────────────────────────────────────
# Public hostname for this deployment
HOSTNAME=hekocms-preview.elevo.solutions
# GitHub repo + branch (must be reachable for Coolify; use HTTPS URL)
GIT_REPOSITORY=https://github.com/elevo-business/hekovoice
GIT_BRANCH=claude/fix-server-offline-Y53iH

# ─── Initial admin (used only on first run) ──────────────
ADMIN_EMAIL=hey@elevo.solutions
# ≥ 10 chars. After first login, REMOVE this env var from Coolify.
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ─── Optional: app naming ────────────────────────────────
# PROJECT_NAME=hekovoice
# APP_NAME=hekovoice-cms-preview

# ─── Optional: re-use a fixed session secret ─────────────
# Auto-generated each run if empty. Set this if you want stable sessions
# across re-runs of the script.
# SESSION_SECRET=
