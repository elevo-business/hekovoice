# ───── Server ─────
NODE_ENV=development
PORT=3000

# ───── Database ─────
DATABASE_PATH=./data/cms.db

# ───── Auth ─────
# Generate via: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-hex-string
SESSION_TTL_HOURS=168

# ───── Initial Admin (seed) ─────
ADMIN_EMAIL=hey@elevo.solutions
ADMIN_PASSWORD=replace-on-first-run
ADMIN_NAME=Admin

# ───── Cloudflare R2 (Bilder) ─────
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=hekovoice-media
R2_PUBLIC_URL=

# ───── Cloudflare Cache-Purge ─────
CLOUDFLARE_API_TOKEN=
CF_ZONE_ID=

# ───── Public URL ─────
PUBLIC_URL=https://hekocms-preview.elevo.solutions
